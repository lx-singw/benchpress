# Google Cloud Platform Configuration
GOOGLE_CLOUD_PROJECT=benchpress-dev
GOOGLE_CLOUD_REGION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=

# Cloud Tasks Queue Configuration & Worker URL (Base Service URL)
GCP_TASKS_QUEUE_NAME=trajectory-execution-queue
GCP_TASKS_LOCATION=us-central1
SANDBOX_WORKER_URL=http://localhost:8000

# Firestore Configuration
FIRESTORE_DATABASE_ID=(default)

# BigQuery Analytics & Telemetry Configuration
BIGQUERY_DATASET=benchpress_analytics
BIGQUERY_TABLE_TRAJECTORIES=trajectories
BIGQUERY_TABLE_TURNS=turn_telemetry

# Vertex AI & Gemini Evaluation Orchestrator Configuration
VERTEX_AI_LOCATION=us-central1
GEMINI_API_KEY=
PLANNER_MODEL=gemini-2.5-pro
CODER_MODEL=gemini-2.5-flash
SUPERVISOR_MODEL=gemini-2.5-pro

# Worker Security & Mock Mode
# Set USE_LOCAL_MOCK=false in production (requires valid GCP credentials & PLANNER_MODEL)
USE_LOCAL_MOCK=true
BENCHPRESS_HMAC_SECRET=benchpress-local-dev-hmac-secret-32b
PORT=8000
HOST=0.0.0.0
