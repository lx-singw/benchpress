{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://benchpress.ai/schemas/task-fingerprint.v1.json",
  "title": "TaskFingerprint",
  "description": "Workload complexity, context weight, workflow phase, and risk classification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "fingerprint_id",
    "task_family",
    "workflow_phase",
    "language",
    "framework",
    "ast_depth",
    "cyclomatic_complexity",
    "context_token_weight",
    "required_tools",
    "risk_class",
    "latency_sensitivity",
    "feature_vector_hash",
    "created_at"
  ],
  "properties": {
    "schema_version": { "type": "string", "enum": ["1.0.0"] },
    "fingerprint_id": { "type": "string", "pattern": "^fp_[a-f0-9]{16}$" },
    "task_family": { "type": "string", "minLength": 1 },
    "workflow_phase": { "type": "string", "enum": ["RESEARCH_PLANNING", "SPECIFICATION", "EXECUTION", "REVIEW", "REFINEMENT", "WHOLE_WORKFLOW"] },
    "language": { "type": "string", "minLength": 1 },
    "framework": { "type": "string", "minLength": 1 },
    "ast_depth": { "type": "integer", "minimum": 0 },
    "cyclomatic_complexity": { "type": "integer", "minimum": 0 },
    "context_token_weight": { "type": "integer", "minimum": 0 },
    "required_tools": {
      "type": "array",
      "items": { "type": "string" }
    },
    "risk_class": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"] },
    "latency_sensitivity": { "type": "string", "enum": ["INTERACTIVE", "NEAR_REALTIME", "BATCH", "BACKGROUND"] },
    "feature_vector_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "created_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$" }
  }
}
