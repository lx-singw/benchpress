{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://benchpress.ai/schemas/policy-version.v1.json",
  "title": "PolicyVersion",
  "description": "Immutable baseline or candidate configuration policy version for workflow routing",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_version",
    "task_segment_id",
    "configuration_id",
    "is_active",
    "state_version",
    "parent_policy_version",
    "promoted_by_decision_id",
    "promoted_at",
    "created_at"
  ],
  "properties": {
    "schema_version": { "type": "string", "enum": ["1.0.0"] },
    "policy_version": { "type": "string", "pattern": "^pol_[0-9A-HJKMNP-TV-Z]{26}$" },
    "task_segment_id": { "type": "string", "minLength": 1 },
    "configuration_id": { "type": "string", "pattern": "^cfg_[a-f0-9]{16}$" },
    "is_active": { "type": "boolean" },
    "state_version": { "type": "integer", "minimum": 1 },
    "parent_policy_version": {
      "type": ["string", "null"],
      "pattern": "^pol_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "promoted_by_decision_id": {
      "type": ["string", "null"],
      "pattern": "^dec_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "promoted_at": {
      "type": ["string", "null"],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "created_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$" }
  }
}
