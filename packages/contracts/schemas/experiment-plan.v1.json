{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://benchpress.ai/schemas/experiment-plan.v1.json",
  "title": "ExperimentPlan",
  "description": "Deterministic evaluation plan containing selected configurations, task cohort, budget reservations, and stop rules",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "experiment_id",
    "correlation_id",
    "event_id",
    "fingerprint_id",
    "baseline_configuration_id",
    "candidate_configuration_ids",
    "task_cohort_version",
    "selected_task_ids",
    "repetitions_per_task",
    "max_matrix_spend_usd",
    "reserved_budget_usd",
    "per_run_timeout_seconds",
    "max_turns_per_run",
    "quality_floor_pass_rate",
    "early_stop_consecutive_failures",
    "planner_model",
    "plan_policy_version",
    "planning_rationale",
    "created_at"
  ],
  "properties": {
    "schema_version": { "type": "string", "enum": ["1.0.0"] },
    "plan_id": { "type": "string", "pattern": "^plan_[a-f0-9]{16}$" },
    "experiment_id": { "type": "string", "pattern": "^exp_[0-9A-HJKMNP-TV-Z]{26}$" },
    "correlation_id": { "type": "string", "pattern": "^corr_[0-9A-HJKMNP-TV-Z]{26}$" },
    "event_id": { "type": "string", "pattern": "^evt_[0-9A-HJKMNP-TV-Z]{26}$" },
    "fingerprint_id": { "type": "string", "pattern": "^fp_[a-f0-9]{16}$" },
    "baseline_configuration_id": { "type": "string", "pattern": "^cfg_[a-f0-9]{16}$" },
    "candidate_configuration_ids": {
      "type": "array",
      "items": { "type": "string", "pattern": "^cfg_[a-f0-9]{16}$" },
      "minItems": 1
    },
    "task_cohort_version": { "type": "string", "minLength": 1 },
    "selected_task_ids": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1
    },
    "repetitions_per_task": { "type": "integer", "minimum": 1 },
    "max_matrix_spend_usd": { "type": "string", "pattern": "^[0-9]+\\.[0-9]{6}$" },
    "reserved_budget_usd": { "type": "string", "pattern": "^[0-9]+\\.[0-9]{6}$" },
    "per_run_timeout_seconds": { "type": "integer", "minimum": 1 },
    "max_turns_per_run": { "type": "integer", "minimum": 1 },
    "quality_floor_pass_rate": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
    "early_stop_consecutive_failures": { "type": "integer", "minimum": 1 },
    "planner_model": { "type": "string", "minLength": 1 },
    "plan_policy_version": { "type": "string", "minLength": 1 },
    "planning_rationale": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$" }
  }
}
