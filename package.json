{
  "name": "benchpress-monorepo",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "turbo test",
    "lint": "turbo lint",
    "clean": "turbo clean && rm -rf node_modules apps/*/node_modules packages/*/node_modules",
    "cloud:bootstrap": "python scripts/cloud_cli.py bootstrap",
    "cloud:secrets:dev": "python scripts/cloud_cli.py secrets --env dev",
    "cloud:secrets:prod": "python scripts/cloud_cli.py secrets --env prod",
    "cloud:deploy:dev": "python scripts/cloud_cli.py deploy --env dev",
    "cloud:deploy:prod": "python scripts/cloud_cli.py deploy --env prod",
    "cloud:smoke:dev": "python scripts/cloud_cli.py smoke --env dev",
    "cloud:smoke:prod": "python scripts/cloud_cli.py smoke --env prod",
    "cloud:teardown:dev": "python scripts/cloud_cli.py teardown --env dev",
    "cloud:teardown:prod": "python scripts/cloud_cli.py teardown --env prod",
    "cloud:env": "python scripts/cloud_cli.py env"
  },
  "devDependencies": {
    "prettier": "^3.5.0",
    "turbo": "^2.4.0",
    "typescript": "^5.7.3"
  },
  "packageManager": "pnpm@10.34.2"
}
