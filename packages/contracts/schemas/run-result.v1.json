{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://benchpress.ai/schemas/run-result.v1.json",
  "title": "RunResult",
  "description": "Terminal execution outcome, provider usage tokens, latency, assertion results, and failure taxonomy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "logical_run_key",
    "attempt_id",
    "experiment_id",
    "correlation_id",
    "configuration_id",
    "task_id",
    "repetition_index",
    "run_state",
    "resolved",
    "failure_reason",
    "turns_executed",
    "prompt_tokens",
    "completion_tokens",
    "cached_tokens",
    "total_tokens",
    "observed_cost_usd",
    "price_version",
    "latency_ms",
    "exit_code",
    "assertions_passed",
    "assertions_failed",
    "eligible_for_aggregation",
    "lease_owner",
    "started_at",
    "finished_at",
    "created_at"
  ],
  "properties": {
    "schema_version": { "type": "string", "enum": ["1.0.0"] },
    "logical_run_key": { "type": "string", "pattern": "^run_[a-f0-9]{16}$" },
    "attempt_id": { "type": "string", "pattern": "^att_[0-9A-HJKMNP-TV-Z]{26}$" },
    "experiment_id": { "type": "string", "pattern": "^exp_[0-9A-HJKMNP-TV-Z]{26}$" },
    "correlation_id": { "type": "string", "pattern": "^corr_[0-9A-HJKMNP-TV-Z]{26}$" },
    "configuration_id": { "type": "string", "pattern": "^cfg_[a-f0-9]{16}$" },
    "task_id": { "type": "string", "minLength": 1 },
    "repetition_index": { "type": "integer", "minimum": 0 },
    "run_state": {
      "type": "string",
      "enum": [
        "PENDING",
        "CLAIMED",
        "PROVIDER_RUNNING",
        "VERIFYING",
        "SUCCEEDED",
        "FAILED_MODEL",
        "FAILED_ORACLE",
        "FAILED_INFRA",
        "TIMED_OUT",
        "BUDGET_EXCEEDED",
        "CANCELLED_BEFORE_START"
      ]
    },
    "resolved": { "type": "boolean" },
    "failure_reason": {
      "type": "string",
      "enum": [
        "NONE",
        "TIMEOUT",
        "MAX_TURNS_EXCEEDED",
        "BUDGET_EXCEEDED",
        "ORACLE_ASSERTION_FAILED",
        "SYNTAX_ERROR",
        "RUNTIME_EXCEPTION",
        "INFRASTRUCTURE_ERROR",
        "PROVIDER_ERROR",
        "CANCELLED"
      ]
    },
    "failure_details": { "type": "string" },
    "turns_executed": { "type": "integer", "minimum": 0 },
    "prompt_tokens": { "type": "integer", "minimum": 0 },
    "completion_tokens": { "type": "integer", "minimum": 0 },
    "cached_tokens": { "type": "integer", "minimum": 0 },
    "reasoning_tokens": { "type": "integer", "minimum": 0 },
    "total_tokens": { "type": "integer", "minimum": 0 },
    "requested_model": { "type": "string", "minLength": 1 },
    "response_model": { "type": "string", "minLength": 1 },
    "provider_response_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "observed_cost_usd": { "type": "string", "pattern": "^[0-9]+\\.[0-9]{6}$" },
    "price_version": { "type": "string", "minLength": 1 },
    "latency_ms": { "type": "integer", "minimum": 0 },
    "exit_code": { "type": "integer" },
    "assertions_passed": { "type": "integer", "minimum": 0 },
    "assertions_failed": { "type": "integer", "minimum": 0 },
    "eligible_for_aggregation": { "type": "boolean" },
    "ineligibility_reason": { "type": "string" },
    "lease_owner": { "type": "string", "minLength": 1 },
    "started_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$" },
    "finished_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$" },
    "created_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$" }
  }
}
