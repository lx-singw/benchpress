{
  "name": "benchpress-monorepo",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "turbo test",
    "lint": "turbo lint",
    "clean": "turbo clean && rm -rf node_modules apps/*/node_modules packages/*/node_modules",
    "cloud:bootstrap": "bash scripts/gcp_bootstrap.sh",
    "cloud:secrets:dev": "bash scripts/gcp_setup_secrets.sh --env dev",
    "cloud:secrets:prod": "bash scripts/gcp_setup_secrets.sh --env prod",
    "cloud:deploy:dev": "bash scripts/gcp_deploy_all.sh --env dev",
    "cloud:deploy:prod": "bash scripts/gcp_deploy_all.sh --env prod",
    "cloud:smoke:dev": "bash scripts/gcp_smoke_test.sh --env dev",
    "cloud:smoke:prod": "bash scripts/gcp_smoke_test.sh --env prod",
    "cloud:teardown:dev": "bash scripts/gcp_teardown.sh --env dev",
    "cloud:teardown:prod": "bash scripts/gcp_teardown.sh --env prod",
    "cloud:env": "bash scripts/setup_cloud_env.sh"
  },
  "devDependencies": {
    "prettier": "^3.5.0",
    "turbo": "^2.4.0",
    "typescript": "^5.7.3"
  },
  "packageManager": "pnpm@10.34.2"
}
