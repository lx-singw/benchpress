{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://benchpress.ai/schemas/replay-event.v1.json",
  "title": "ReplayEvent",
  "description": "Ordered, timestamped trajectory and experiment state transition log for auditability",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "sequence_id",
    "experiment_id",
    "correlation_id",
    "from_state",
    "to_state",
    "actor",
    "payload_hash",
    "transition_reason",
    "timestamp"
  ],
  "properties": {
    "schema_version": { "type": "string", "enum": ["1.0.0"] },
    "sequence_id": { "type": "integer", "minimum": 0 },
    "experiment_id": { "type": "string", "pattern": "^exp_[0-9A-HJKMNP-TV-Z]{26}$" },
    "correlation_id": { "type": "string", "pattern": "^corr_[0-9A-HJKMNP-TV-Z]{26}$" },
    "from_state": {
      "type": "string",
      "enum": [
        "RECEIVED",
        "PLANNING",
        "PLAN_REJECTED",
        "PLAN_APPROVED",
        "DISPATCHING",
        "RUNNING",
        "AGGREGATING",
        "REJECTED",
        "ABSTAINED",
        "CANARY_PENDING",
        "CANARY_RUNNING",
        "ROLLED_BACK",
        "RECOMMENDED",
        "PUBLISHED",
        "FAILED_TERMINAL"
      ]
    },
    "to_state": {
      "type": "string",
      "enum": [
        "RECEIVED",
        "PLANNING",
        "PLAN_REJECTED",
        "PLAN_APPROVED",
        "DISPATCHING",
        "RUNNING",
        "AGGREGATING",
        "REJECTED",
        "ABSTAINED",
        "CANARY_PENDING",
        "CANARY_RUNNING",
        "ROLLED_BACK",
        "RECOMMENDED",
        "PUBLISHED",
        "FAILED_TERMINAL"
      ]
    },
    "actor": { "type": "string", "minLength": 1 },
    "payload_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "transition_reason": { "type": "string", "minLength": 1 },
    "timestamp": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$" }
  }
}
