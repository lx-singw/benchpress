# Google Cloud Platform Configuration
GOOGLE_CLOUD_PROJECT=benchpress-dev
GOOGLE_CLOUD_REGION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=

# Cloud Tasks Queue Configuration
GCP_TASKS_QUEUE_NAME=trajectory-execution-queue
GCP_TASKS_LOCATION=us-central1
SANDBOX_WORKER_URL=http://localhost:8080/execute-task

# Firestore Configuration
FIRESTORE_DATABASE_ID=(default)

# BigQuery Configuration
BIGQUERY_DATASET=benchpress_telemetry
BIGQUERY_TABLE_TRAJECTORIES=trajectory_runs
BIGQUERY_TABLE_TURNS=turn_telemetry

# Vertex AI & Gemini Configuration
VERTEX_AI_LOCATION=us-central1
GEMINI_API_KEY=

# Worker Security & HMAC
BENCHPRESS_HMAC_SECRET=benchpress-local-dev-hmac-secret-32b
USE_LOCAL_MOCK=true
PORT=8080
