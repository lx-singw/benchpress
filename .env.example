# Runtime boundary: local_mock, development, rehearsal, or production.
RUNTIME_MODE=local_mock
# Deprecated compatibility value. It must agree with RUNTIME_MODE when present.
USE_LOCAL_MOCK=true
RELEASE_SHA=local-development

# Google Cloud
GOOGLE_CLOUD_PROJECT=benchpress-dev
GOOGLE_CLOUD_REGION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=
FIRESTORE_DATABASE_ID=(default)
FIRESTORE_COLLECTION_PREFIX=local
REPOSITORY_BACKEND=memory
# Published measured experiment used by the recommendation endpoint outside local_mock.
ROUTING_DECISION_EXPERIMENT_ID=

# Cloud Tasks and worker identity
GCP_TASKS_QUEUE_NAME=local-trajectory-queue
GCP_TASKS_LOCATION=us-central1
SANDBOX_WORKER_URL=http://localhost:8000
TASKS_OIDC_AUDIENCE=http://localhost:8000
GCP_TASKS_INVOKER_SERVICE_ACCOUNT=local-tasks-invoker@benchpress-dev.iam.gserviceaccount.com

# GenAI. Non-local modes require the exact account-verified Gemini 3.5+ model ID.
VERTEX_AI_LOCATION=us-central1
GENAI_USE_VERTEXAI=false
GEMINI_API_KEY=
PLANNER_MODEL=gemini-3.5-local-fixture
CODER_MODEL=gemini-2.5-flash
SUPERVISOR_MODEL=gemini-2.5-pro

# Frozen execution ceilings
MAX_MATRIX_SPEND_USD=0.50
PER_RUN_SPEND_CEILING_USD=0.05
DEFAULT_BUDGET_LIMIT_USD=0.05
MAX_TURNS=15
MAX_TOOL_CALLS=20
PER_RUN_TIMEOUT_SECONDS=60
MAX_PROVIDER_RETRIES=2
CONCURRENCY_LIMIT=4
EARLY_HALT_TURN_THRESHOLD=5

# BigQuery
BIGQUERY_DATASET=benchpress_dev_analytics
BIGQUERY_TABLE_TRAJECTORIES=trajectories
BIGQUERY_TABLE_TURN_TELEMETRY=turn_telemetry

# Local-only compatibility secret; Cloud Tasks OIDC is required outside local_mock.
BENCHPRESS_HMAC_SECRET=local-development-only
PORT=8000
HOST=0.0.0.0
