{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://benchpress.ai/schemas/run-manifest.v1.json",
  "title": "RunManifest",
  "description": "Immutable task execution specification and tool allowlists",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "logical_run_key",
    "experiment_id",
    "correlation_id",
    "configuration_id",
    "task_id",
    "task_version_hash",
    "repetition_index",
    "harness_version",
    "oracle_version",
    "tool_allowlist",
    "path_allowlist",
    "max_turns",
    "timeout_seconds",
    "max_spend_usd",
    "created_at"
  ],
  "properties": {
    "schema_version": { "type": "string", "enum": ["1.0.0"] },
    "logical_run_key": { "type": "string", "pattern": "^run_[a-f0-9]{16}$" },
    "experiment_id": { "type": "string", "pattern": "^exp_[0-9A-HJKMNP-TV-Z]{26}$" },
    "correlation_id": { "type": "string", "pattern": "^corr_[0-9A-HJKMNP-TV-Z]{26}$" },
    "configuration_id": { "type": "string", "pattern": "^cfg_[a-f0-9]{16}$" },
    "task_id": { "type": "string", "minLength": 1 },
    "task_version_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "repetition_index": { "type": "integer", "minimum": 0 },
    "harness_version": { "type": "string", "minLength": 1 },
    "oracle_version": { "type": "string", "minLength": 1 },
    "tool_allowlist": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "path_allowlist": {
      "type": "array",
      "items": { "type": "string" }
    },
    "max_turns": { "type": "integer", "minimum": 1 },
    "timeout_seconds": { "type": "integer", "minimum": 1 },
    "max_spend_usd": { "type": "string", "pattern": "^[0-9]+\\.[0-9]{6}$" },
    "created_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$" }
  }
}
