{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://benchpress.ai/schemas/native-configuration.v1.json",
  "title": "NativeConfiguration",
  "description": "Exact provider and native reasoning model configuration parameters",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "configuration_id",
    "provider",
    "request_model",
    "max_output_tokens",
    "system_instruction_hash",
    "tool_schema_hash",
    "price_input_per_million_usd",
    "price_output_per_million_usd",
    "price_source_version",
    "created_at"
  ],
  "properties": {
    "schema_version": { "type": "string", "enum": ["1.0.0", "1.1.0"] },
    "configuration_id": { "type": "string", "pattern": "^cfg_[a-f0-9]{16}$" },
    "provider": { "type": "string", "minLength": 1 },
    "request_model": { "type": "string", "minLength": 1 },
    "resolved_model_snapshot": { "type": "string" },
    "thinking_budget_tokens": { "type": "integer", "minimum": 0 },
    "thinking_level": { "type": "string", "enum": ["low", "medium", "high"] },
    "temperature": { "type": "number", "minimum": 0.0, "maximum": 2.0 },
    "top_p": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
    "max_output_tokens": { "type": "integer", "minimum": 1 },
    "system_instruction_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "tool_schema_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "price_input_per_million_usd": { "type": "string", "pattern": "^[0-9]+\\.[0-9]{6}$" },
    "price_output_per_million_usd": { "type": "string", "pattern": "^[0-9]+\\.[0-9]{6}$" },
    "price_source_version": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "request_model": { "pattern": "^gemini-3\\.7" } },
        "required": ["request_model"]
      },
      "then": {
        "properties": { "schema_version": { "const": "1.1.0" } },
        "required": ["thinking_level"],
        "not": {
          "anyOf": [
            { "required": ["thinking_budget_tokens"] },
            { "required": ["temperature"] },
            { "required": ["top_p"] }
          ]
        }
      },
      "else": {
        "properties": { "schema_version": { "const": "1.0.0" } },
        "required": ["thinking_budget_tokens", "temperature", "top_p"],
        "not": { "required": ["thinking_level"] }
      }
    }
  ]
}
