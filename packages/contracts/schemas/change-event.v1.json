{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://benchpress.ai/schemas/change-event.v1.json",
  "title": "ChangeEvent",
  "description": "Sanitized provider model/price change trigger with baseline configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "correlation_id",
    "event_type",
    "source_kind",
    "source_reference",
    "target_provider",
    "target_model_family",
    "changed_fields",
    "source_checksum",
    "effective_at",
    "retrieved_at",
    "baseline_policy_version",
    "baseline_configuration_id",
    "max_spend_usd",
    "deadline_at",
    "initiator",
    "replay",
    "created_at"
  ],
  "properties": {
    "schema_version": { "type": "string", "enum": ["1.0.0"] },
    "event_id": { "type": "string", "pattern": "^evt_[0-9A-HJKMNP-TV-Z]{26}$" },
    "correlation_id": { "type": "string", "pattern": "^corr_[0-9A-HJKMNP-TV-Z]{26}$" },
    "event_type": { "type": "string", "enum": ["MODEL_RELEASE", "PRICE_CHANGE", "REASONING_UPGRADE", "DEPRECATION_NOTICE", "MANUAL_TRIGGER", "SCHEDULED_SWEEP"] },
    "source_kind": { "type": "string", "enum": ["PROVIDER_CATALOG", "PRICE_INDEX", "ADMIN_CONSOLE", "WEBHOOK", "SYNTHETIC_REPLAY"] },
    "source_reference": { "type": "string", "minLength": 1 },
    "target_provider": { "type": "string", "minLength": 1 },
    "target_model_family": { "type": "string", "minLength": 1 },
    "changed_fields": {
      "type": "array",
      "items": { "type": "string" }
    },
    "source_checksum": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "effective_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$" },
    "retrieved_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$" },
    "baseline_policy_version": { "type": "string", "pattern": "^pol_[0-9A-HJKMNP-TV-Z]{26}$" },
    "baseline_configuration_id": { "type": "string", "pattern": "^cfg_[a-f0-9]{16}$" },
    "max_spend_usd": { "type": "string", "pattern": "^[0-9]+\\.[0-9]{6}$" },
    "deadline_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$" },
    "initiator": { "type": "string", "minLength": 1 },
    "replay": { "type": "boolean" },
    "replay_label": { "type": "string" },
    "created_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$" }
  }
}
